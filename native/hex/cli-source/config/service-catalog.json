{
  "schema": "xiio.cli.service-catalog/v1",
  "product": "xi-io: CLI",
  "rules": [
    "SERVICE_ID != PROCESS_NAME != MACHINE_NODE != AGENT_REF",
    "ENGINE != MODEL",
    "MODEL_SELECTION != RUNTIME_INSTALL",
    "SERVICE_PRESENT != SERVICE_HEALTHY",
    "SERVICE_HEALTHY != EFFECT_AUTHORITY",
    "START != READY != USABLE",
    "INSTALL_PLAN != INSTALL_APPLY"
  ],
  "profiles": {
    "aries-dev": {
      "node_ref": "node.aries",
      "role": "workstation",
      "description": "Selected workstation services (Ollama/Ibal/Studio/dev plane). Not the public product host. Profile JSON changes do not stop or remove running software.",
      "services": [
        "ollama",
        "local-agent-api",
        "ibal",
        "studio-ui",
        "api-glass-private",
        "dev-gateway",
        "switchboard-device-consumer"
      ]
    },
    "loki-live": {
      "node_ref": "node.loki",
      "role": "server",
      "description": "Public web, CRM, BINS, Inbox, HEX, and mail-server host. Preserves local-agent + Switchboard authority. mail-server stays PROFILE_REQUIRED_NOT_AUTO_INSTALLED until Chris authorizes install.",
      "services": [
        "local-agent-api",
        "public-web",
        "cloudflared",
        "crm",
        "bins",
        "inbox",
        "hex",
        "mail-server",
        "switchboard-device-consumer"
      ]
    }
  },
  "services": [
    {
      "id": "ollama",
      "class": "ai_engine",
      "runtime": "ollama",
      "model_agnostic": true,
      "probe": "http://127.0.0.1:11434/api/tags",
      "systemd_candidates": [
        "ollama.service"
      ],
      "install_provider": "ollama"
    },
    {
      "id": "local-agent-api",
      "class": "local_cli_api",
      "runtime": "xi-io: CLI local agent",
      "model_agnostic": true,
      "probe": "http://127.0.0.1:3109/v1/status",
      "systemd_candidates": [
        "xiio-local-agent.service",
        "xi-io-local-agent.service"
      ],
      "install_provider": "xi-io-sdk",
      "cli_access": "read_write"
    },
    {
      "id": "ibal",
      "class": "ai_orchestrator",
      "runtime": "xi-io: Ibal",
      "model_agnostic": true,
      "probe": "http://127.0.0.1:3000/api/ibal/runtime/health",
      "systemd_candidates": [
        "xiio-ibal.service",
        "xi-io-ibal.service"
      ]
    },
    {
      "id": "studio-ui",
      "class": "web_ui",
      "probe": "http://127.0.0.1:3099/",
      "systemd_candidates": [
        "xiio-studio.service",
        "xi-io-studio.service"
      ]
    },
    {
      "id": "api-glass-private",
      "class": "truth_api",
      "probe": "http://127.0.0.1:4391/healthz",
      "systemd_candidates": [
        "xiio-dev-truth.service"
      ]
    },
    {
      "id": "dev-gateway",
      "class": "web_gateway",
      "probe": "http://127.0.0.1:4390/__xiio/dev-health",
      "systemd_candidates": [
        "xiio-dev.service"
      ]
    },
    {
      "id": "inbox",
      "class": "mail_ui",
      "probe": "http://127.0.0.1:8791/api/health",
      "systemd_candidates": [
        "xiio-inbox-dogfood-8791.service",
        "xiio-inbox-8787.service",
        "xiio-inbox.service"
      ]
    },
    {
      "id": "crm",
      "class": "crm",
      "probe": "http://127.0.0.1:8794/health",
      "systemd_candidates": [
        "xiio-crm-8794.service",
        "xiio-crm.service"
      ]
    },
    {
      "id": "bins",
      "class": "bins_custody",
      "runtime": "xi-io: BINS",
      "probe": "http://127.0.0.1:8796/health",
      "systemd_candidates": [
        "xiio-bins-8796.service",
        "xiio-bins.service"
      ],
      "install_provider": "xi-io_bins",
      "notes": "Declared product probe is disposable BINS :8796. A listening port alone is not product identity; :8797 is a separate staging/side runtime.",
      "systemd_action_unit": "xiio-bins-8796.service"
    },
    {
      "id": "hex",
      "class": "operator_control",
      "probe": "http://127.0.0.1:8798/health",
      "systemd_candidates": [
        "xi-io-hex-rc.service",
        "xiio-hex.service"
      ]
    },
    {
      "id": "cloudflared",
      "class": "edge_tunnel",
      "probe": null,
      "systemd_candidates": [
        "cloudflared.service",
        "xiio-cloudflared-webserver.service",
        "xi-io-tunnel.service"
      ]
    },
    {
      "id": "public-web",
      "class": "web_public",
      "probe": "http://127.0.0.1/",
      "systemd_candidates": [
        "nginx.service",
        "caddy.service",
        "apache2.service"
      ]
    },
    {
      "id": "mail-server",
      "class": "mail_transport",
      "probe": null,
      "systemd_candidates": [
        "postfix.service",
        "dovecot.service"
      ],
      "install_provider": "system-mail",
      "selected_provider_profile": "postfix+dovecot",
      "selection": "POSTFIX_DOVECOT_ON_LOKI_SELECTED",
      "state": "PROFILE_REQUIRED_NOT_AUTO_INSTALLED",
      "notes": "Chris selected Postfix+Dovecot on Loki. Catalog declares intent only. Install/qualify owned by mail seat; CLI install remains gated until qualify PASS. Profile JSON must never stop or remove running software."
    },
    {
      "id": "switchboard-device-consumer",
      "class": "device_worker",
      "runtime": "xi-io: Switchboard native device consumer",
      "probe": null,
      "systemd_candidates": [
        "xiio-switchboard-device-consumer.service"
      ],
      "install_provider": "xi-io-Switchboard",
      "state": "AUTHORITY_ENV_REQUIRED"
    }
  ],
  "ai_engines": [
    {
      "id": "ollama",
      "kind": "local_open_model_runtime",
      "default_base": "http://127.0.0.1:11434",
      "model_discovery": "/api/tags"
    },
    {
      "id": "openai-compatible",
      "kind": "openai_compatible",
      "default_base": null,
      "model_discovery": "/v1/models"
    },
    {
      "id": "anthropic-compatible",
      "kind": "anthropic_compatible",
      "default_base": null,
      "model_discovery": null
    },
    {
      "id": "gemini-compatible",
      "kind": "gemini_compatible",
      "default_base": null,
      "model_discovery": null
    }
  ]
}
