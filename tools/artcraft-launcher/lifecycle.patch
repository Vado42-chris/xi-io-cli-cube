+/// A host retains this handle for exactly as long as its supplied canvas lives.
+/// It owns the real LauncherUi runner, not a parallel catalog or window.
+#[cfg(feature = "hosted-canvas")]
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub struct LauncherHandle {
+    runner: eframe::WebRunner,
+}
+
+#[cfg(feature = "hosted-canvas")]
+#[wasm_bindgen::prelude::wasm_bindgen]
+impl LauncherHandle {
+    /// Stop callbacks, animation frames and graphics resources before removing the canvas.
+    pub fn destroy(&self) {
+        self.runner.destroy();
+    }
+}
+
+#[cfg(feature = "hosted-canvas")]
+impl Drop for LauncherHandle {
+    fn drop(&mut self) {
+        self.runner.destroy();
+    }
+}
+
+/// Explicit element input works inside the host's ShadowRoot.
+/// The promise resolves only after the real eframe startup completes.
+/// The host must destroy/free a late result if it unmounted while awaiting startup.
+#[cfg(feature = "hosted-canvas")]
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub async fn mount_launcher(canvas: web_sys::HtmlCanvasElement) -> Result<LauncherHandle, wasm_bindgen::JsValue> {
+    eframe::WebLogger::init(log::LevelFilter::Warn).ok();
+    let runner = eframe::WebRunner::new();
+    start_runner(&runner, canvas).await?;
+    Ok(LauncherHandle { runner })
+}
+
+async fn start_runner(runner: &eframe::WebRunner, canvas: web_sys::HtmlCanvasElement) -> Result<(), wasm_bindgen::JsValue> {
+    let result = runner
+        .start(
+            canvas,
+            eframe::WebOptions::default(),
+            Box::new(|cc| {
+                let ctx = cc.egui_ctx.clone();
+                let settings: Settings = cc.storage.and_then(|s| eframe::get_value(s, SETTINGS_KEY)).unwrap_or_default();
+                let backend = WebBackend::new(ctx.clone());
+                Ok(Box::new(WebApp { ui: LauncherUi::new(&ctx, Box::new(backend), settings) }))
+            }),
+        )
+        .await;
+    if result.is_err() {
+        runner.destroy();
+    }
+    result
+}
 
