@@ -0,0 +1,28 @@
+//! Host-supplied presentation for the existing renderer.
+//!
+//! These values describe visible choices only. They contain no installed-state,
+//! package, release, download, capability or authorization receipt.
+
+use artcraft_launcher_core::CraftApp;
+
+/// A finite, source-owned catalog supplied explicitly by an embedding product.
+pub struct HostedCatalog {
+    pub title: &'static str,
+    pub subtitle: &'static str,
+    pub products: &'static [CraftApp],
+    /// Product selections that the host may turn into an installation review.
+    pub reviewable: &'static [&'static str],
+    /// Surface, light-ink and dark-ink accents from the host's existing brand.
+    pub accent: [[u8; 3]; 3],
+    pub footer: &'static str,
+}
+
+impl HostedCatalog {
+    pub fn can_review(&self, id: &str) -> bool {
+        self.reviewable.contains(&id) && self.products.iter().any(|app| app.id == id)
+    }
+
+    pub fn availability(&self, id: &str) -> &'static str {
+        if self.can_review(id) { "Installation review available" } else { "Package unavailable in this build" }
+    }
+}
